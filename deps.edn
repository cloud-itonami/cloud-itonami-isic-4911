{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; actor is deliberately self-contained R0 (no bespoke domain capability
 ;; library dependency): its four proposal ops (log-service-record,
 ;; schedule-service-operation, flag-passenger-safety-concern,
 ;; coordinate-maintenance) are OPERATIONS-COORDINATION records, not a
 ;; wrapper around a real dispatch/signal-safety/rolling-stock-control
 ;; system -- there is no existing kotoba-lang capability library for
 ;; that boundary to wrap (unlike `cloud-itonami-isic-4920`, which wraps
 ;; the real `kotoba-lang/logistics` tracking-number contract). This repo
 ;; is standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork should
 ;; override them with git coordinates.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics {:local/root "../../kotoba-lang/robotics"}

        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "f7b3fca8e08147ae7d658fe36ae0475a45fb76a9"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  :physai-test {:extra-paths ["test" "test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "railops.sim"]}
  ;; kbb -M:dev:render-html -> drive the REAL actor stack and write
  ;; docs/samples/operator-console.html (deterministic build-time
  ;; artifact -- no server, no clock, no network).
  :render-html {:main-opts ["-m" "railops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
